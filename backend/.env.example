# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmamedian

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# Twilio – WhatsApp integration
# Set TWILIO_TEST_MODE=true during development to route to test numbers.
# Set TWILIO_TEST_MODE=false (or omit) in production.
# ------------------------------------------------------------------
TWILIO_TEST_MODE=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_CONTENT_SID=your-twilio-content-sid

# Test recipient numbers (used ONLY when TWILIO_TEST_MODE=true)
TEST_PHARMACY_WHATSAPP=whatsapp:+919791191427
TEST_DISTRIBUTOR_WHATSAPP=whatsapp:+919791191427
TEST_MANUFACTURER_WHATSAPP=whatsapp:+919791191427
TEST_DISPOSAL_WHATSAPP=whatsapp:+919791191427
